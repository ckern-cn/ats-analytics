# Copy to /etc/ats-capi.env (mode 0600, owner root) and fill in the secrets.
# systemd reads this file before dropping privileges to the ats user.
#
# The admin password is sent by the browser as SHA-256; either set the
# plaintext (simplest) or a precomputed hex digest.

ATS_BASE_URL=https://ats.ckern.cn
ATS_COOKIE_DOMAIN=ats.ckern.cn
ATS_ADMIN_USER=admin
# Preferred: a 64-character SHA-256 hex digest. The install script and
# tools/set-password.sh write this form.
ATS_ADMIN_PASSWORD_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# ATS_ADMIN_PASSWORD=plaintext-is-also-accepted-but-less-private

# Optional. When unset, the service creates data/jwt.key (mode 0600) on the
# first start and reuses it, so sessions survive a restart.
# ATS_JWT_KEY=replace-with-32-bytes-of-random-hex

# Local UTC offset used for the dashboard's day buckets and timestamps.
ATS_TZ_OFFSET_MIN=480
# UI language: zh-CN (default) or en.
ATS_DEFAULT_LOCALE=zh-CN

# Session lifetime (seconds) and data retention (days).
ATS_SESSION_SECONDS=43200
ATS_RETENTION_DAYS=365

# Optional path overrides (the defaults are relative to /webapps/ats-c).
# ATS_DB_PATH=/webapps/ats-c/data/ats.db
# ATS_GEOIP_DB_PATH=/webapps/ats-c/data/GeoLite2-Country.mmdb
