# Optional: restrict the admin surface to your own networks.
#
# Put this location block in the ats.ckern.cn server block *before* the
# generic `location /`. The tracking endpoints (/rv.js, /wru, /pv) must stay
# public, so they are intentionally not listed here.
#
# Replace 203.0.113.0/24 with your office/home/VPN range. 127.0.0.1 is useful
# for local health checks and curl from the host itself.

location ~ ^/(dv|create|edit|export|do_create|do_update|do_delete|login|do_login|logout) {
    allow 127.0.0.1;
    allow 203.0.113.0/24;
    deny all;

    proxy_pass http://ats_capi;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
}
